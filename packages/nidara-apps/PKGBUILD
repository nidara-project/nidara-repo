# Maintainer: Nidara Project <https://github.com/nidara-project>
#
# nidara-apps — the curated application set.
#
# ─── WHAT THIS IS FOR ────────────────────────────────────────────────────────
# `nidara` answers "what does the desktop need to RUN" — its depends are the
# things the shell would be broken without, the terminal and file manager it
# shells out to included. This package answers a different question: "what makes
# a freshly installed machine USABLE". A browser, a way to open a PDF, that kind
# of thing. Nothing here is required by any code.
#
# Keeping the two apart is the point. It is what lets each install path make its
# own choice with one line, instead of the answer being wherever it happened to
# get typed:
#
#     install.sh   → nidara                    (never this package: it runs on an
#                                               Arch someone already uses, with
#                                               their own apps already chosen)
#     the ISO      → nidara + nidara-apps      (+ the medium's own kernel,
#                                               firmware and installer tools,
#                                               which never reach the target)
#     the installer→ nidara + nidara-apps      (what lands on the disk)
#     anyone else  → pacman -S nidara-apps     (opt in, one command)
#
# ─── THE LIST ────────────────────────────────────────────────────────────────
# Decided 2026-09-13. The rule it follows: double-clicking any ordinary file a
# person has — a photo, a PDF, a video, a song, a .zip, a font — opens
# something, and the basic desktop tools nobody should have to go looking for
# (calculator, clock, weather, a notepad, "what is eating my disk",
# "what is hanging") are already there. Official repositories only: nothing
# from the AUR, ever, in this list.
#
# NOT here: gnome-calendar. Alone it was ~330 MiB of the ~470 MiB this set
# adds, because evolution-data-server brings two WebKit builds and the GNOME
# Online Accounts library with it — GNOME services Nidara does not otherwise
# run. The bar has its own calendar; a full one is a later decision.
#
# NOT here because the desktop already depends on them: the terminal (kitty)
# and the file manager (nautilus).
#
# TO CHANGE THE SET: edit depends= below and BUMP pkgver. Without the bump the
# repo republishes the same version and no existing install ever sees the
# change. pkgver is a plain counter on purpose — this package has no upstream
# and no version of its own to track.
#
# Deliberately NOT depending on `nidara`: asking for the app set should not drag
# in a whole desktop as a side effect. The ISO and the installer name both.
pkgname=nidara-apps
pkgver=2
pkgrel=1
pkgdesc="Nidara — the curated application set (metapackage, ships no files)"
arch=(any)
url="https://github.com/nidara-project/nidara-repo"
license=(GPL-3.0-only)

depends=(
  # A machine with no way to browse the web is broken.
  firefox

  # Opening what a person already has. All GTK4, so they follow the desktop's
  # accent and light/dark through the Settings portal.
  loupe                 # images
  papers                # PDF and documents (evince's successor)
  showtime              # video (totem's successor)
  decibels              # audio: open a file, it plays — no library indexer
  file-roller           # open and browse an archive (Nautilus extracts on its own)
  gnome-font-viewer     # double-click a .ttf to preview and install it

  # Codecs. showtime and decibels already pull gst-plugins-good; gst-libav is
  # NOT pulled by anything, and without it h264/h265 — most video a person has —
  # does not play. Both listed so that neither disappears by accident.
  gst-plugins-good
  gst-libav

  # Everyday tools.
  gnome-calculator
  gnome-clocks          # world clocks, alarms, timers
  gnome-weather
  gnome-text-editor     # the notepad

  # When something goes wrong.
  mission-center        # task manager: CPU, memory, GPU, disks, per-app
                        # (chosen over gnome-system-monitor, which shows no GPU)
  gnome-disk-utility    # format a USB stick, SMART, mount an image — GTK3, no
                        # mature GTK4 replacement
  baobab                # what is using the disk
)
