# Maintainer: Nidara Project <https://github.com/nidara-project>
#
# nidara-system — what Nidara changes about Arch itself.
#
# ─── THE LAYER THIS IS ───────────────────────────────────────────────────────
# `nidara` answers "what does the desktop need to RUN". `nidara-apps` answers
# "what makes a fresh machine USABLE". This one answers the third question,
# which had no owner until 2026-08-30: "what does Nidara change about ARCH".
#
# The boundary is one line, and it is the whole reason this package exists:
#
#     if an Arch user installing ONLY the desktop would not want it,
#     it does not go in `nidara`.
#
# GNOME Shell does not depend on Plymouth; Ubuntu ships a Plymouth theme. The
# boot splash below spent four days inside the desktop's own package, where it
# would have repainted the boot of every Arch user who ran install.sh — a
# machine install.sh is explicitly required to treat as theirs. The full model
# is nidara-iso/PRODUCT.md, "Four layers, and the third one had no owner".
#
# ─── WHY IT LIVES IN nidara-repo AND NOT IN nidara-iso ───────────────────────
# PRODUCT.md first said nidara-iso, beside `nidara-release`. That was written
# before two things were known, and both of them point here instead:
#
#   1. `nidara-release` lives there because its version WAS the product's, so it
#      had to be locked to the image's tag. That version is being removed — the
#      machine is rolling and images carry a date — so the coupling that put it
#      there does not apply to anything else.
#   2. nidara-repo's build fetches nidara-iso by TAG (`NIDARA_ISO_REF`), and the
#      product's tagging scheme is exactly what is in flux. Pinning system
#      policy to a scheme mid-change buys a second problem for free.
#
# What settles it is the rule `nidara-apps` already established next door: the
# packages that live in nidara-repo are the ones whose CONTENT must be able to
# change without cutting a release of something else. A boot default must not
# require building a 2 GiB image, for the same reason the browser must not.
#
# ─── WHAT IS DECIDED HERE, AND WHAT IS MERELY INHERITED ──────────────────────
# The Plymouth theme is a decision: Nidara boots as itself.
#
# The persistent journal is a decision too, and a newer one (2026-09-06): Arch's
# default keeps the log in memory, so a machine that failed before anybody could
# open a terminal explains nothing after the reboot that follows. The reasoning
# and the size cap are in the file.
#
# ⚠️ The watchdog setting is NOT. It arrived with nidara-desktop#284 to silence a
# shutdown warning seen in a test VM, and nobody has ratified it as a product
# default. The file says so, in the file.
#
# It also came in FIVE times larger than it needed to be, and reading systemd's
# documentation rather than the pull request cut it to one line. Three of the
# four keys were already the default or a deprecated alias — they changed
# nothing while implying we were doing three more things than we were — and the
# `/etc/modprobe.d` blacklist that came with them is gone entirely: it takes the
# watchdog device away from every machine, permanently, to silence a message
# that only appears because systemd armed it. Do not arm it, and there is
# nothing to silence. (The claim this header used to make — that disabling it
# "removes what recovers a hung machine" — was wrong: Arch ships
# `RuntimeWatchdogSec=0`, so nothing is being recovered today.)
#
# TO CHANGE ANY POLICY: edit below and BUMP pkgver. Without the bump the repo
# republishes the same version and no existing install ever sees the change.
# pkgver is a plain counter on purpose — this package has no upstream, the same
# way nidara-apps has none.
pkgname=nidara-system
pkgver=9
pkgrel=1
pkgdesc="Nidara — what the product changes about Arch itself (boot splash, system defaults, the AUR, printing)"
arch=(any)
url="https://github.com/nidara-project/nidara-repo"
license=(GPL-3.0-only)
# No source=(): makepkg's source array takes files and URLs, not directories, and
# the Plymouth theme is 76 of them. So package() reads `files/` out of $startdir,
# the PKGBUILD's own directory. That is a real constraint on the publisher rather
# than a detail — `nidara-repo`'s build-repo.sh copies a bare PKGBUILD into a
# scratch directory for its other packages, and for this one it has to copy the
# WHOLE directory or $startdir/files does not exist and package() dies. It is
# written down in build-repo.sh too, next to the code that does it.
# plymouth supplies both halves this package is useless without: the daemon that
# draws the splash, and the `plymouth` mkinitcpio hook at
# /usr/lib/initcpio/{hooks,install}/plymouth that the drop-in below names. A
# theme without them is a directory nobody reads — which is precisely how this
# shipped inert for four days when it was in the desktop's package with no
# dependency at all.
depends=(
  plymouth
  # The AUR is AVAILABLE on a Nidara machine (decided 2026-09-13): nothing the
  # product chooses to install comes from it — nidara-apps is official
  # repositories only — but anyone who wants an AUR package types `yay -S` and
  # it works, and anyone who does not never touches it. yay is built by this
  # repo from a pinned AUR commit (YAY_AUR_REF in pins.env), not taken from the
  # AUR at install time.
  yay
  # yay builds AUR packages with makepkg, and makepkg needs the compiler and
  # fakeroot. Without base-devel the AUR is "enabled" and the first `yay -S`
  # fails, which is worse than not offering it.
  base-devel
  # The system-wide fastfetch look (the "N" logo); the config is below.
  fastfetch
  # Printing. Not the desktop's: nothing in nidara-desktop talks to CUPS — apps
  # print through GTK's print dialog, which does. It arrived in the desktop's
  # depends (#529) with `systemctl enable --now cups.socket` in nidara-setup,
  # which an Arch user installing only the desktop would not want. Enabling a
  # system service is policy, so it lives here; `.install` enables cups.service
  # (why the service and not just the socket is written there).
  cups
  # Location portal plumbing. The client is upstream xdg-desktop-portal, not
  # Nidara's portal backend: it asks Nidara's Access backend first, then starts a
  # GeoClue client over D-Bus. GeoClue reaches the machine today only through
  # gnome-weather (nidara-apps), so changing a weather app would otherwise remove
  # a system service the portal needs. GeoClue also ships its whitelisted demo
  # agent and autostarts it here; until Nidara owns that second authorization
  # step, a granted portal request may be followed by its libnotify prompt.
  geoclue
  # The localized default folders (Documents, Downloads...) on first login:
  # this package's XDG autostart entry runs xdg-user-dirs-update, which the
  # session starts through uwsm (config/hypr/hyprland.lua's `uwsm finalize`).
  # Today it arrives via nautilus → xdg-user-dirs-gtk. That chain is sturdier
  # (nautilus is core), but creating the user's folders is session policy, and
  # policy is declared, not inherited.
  xdg-user-dirs
)
# NOT a dependency of `nidara`, and nothing depends on this. The ISO and the
# installer name it explicitly, which is exactly the list of paths entitled to
# change somebody's boot: a machine that got the desktop from install.sh is not
# on it.
install=nidara-system.install

# ⚠️ ONE of the four files this package puts under /etc is backed up, and the
# asymmetry IS the decision — the same shape as nidara-release's, where
# /etc/os-release is identity and the mirrorlist is configuration.
#
# The three that are NOT backed up all live in a drop-in DIRECTORY, which exists
# precisely so that nobody has to edit the vendor's file: a file that sorts after
# ours wins (99-local.conf, zz-local.conf), and nidara-journal.conf tells the
# admin so in its own text. Backing them up would freeze OUR half of those
# directories at whatever version a machine happened to install first, on paths
# where a stale copy produces a machine that behaves like an older release with
# nothing on screen to say why. The mkinitcpio drop-in is the clearest of the
# three: it is on the path that builds the initramfs, and it already refuses to
# touch the machine's own HOOKS (it edits the array it inherits instead of
# declaring one), so the only thing an upgrade replaces there is our insertion
# logic — which is exactly the part that must be allowed to improve.
#
# The one that IS backed up has no drop-in directory at all. fastfetch reads the
# FIRST config it finds and stops; `fastfetch --list-config-paths` prints
# ~/.config/fastfetch/, ~/fastfetch/, /etc/xdg/fastfetch/, /etc/fastfetch/ in
# that order, so /etc/fastfetch/ is not an override point — it sorts BELOW ours
# and is never reached while this file exists. A user replaces the whole thing
# with ~/.config/fastfetch/config.jsonc; an ADMIN who wants every account on the
# machine greeted differently has exactly one lever, and it is this file.
#
# backup= does not weaken what the file is for: an UNMODIFIED copy is still
# replaced by the upgrade, which is how a change to the greeting reaches
# everybody. Only a file somebody actually edited is kept, with ours arriving
# beside it as .pacnew.
backup=(etc/xdg/fastfetch/config.jsonc)

package() {
    # The boot splash.
    install -d "$pkgdir/usr/share/plymouth/themes/nidara"
    install -m644 "$startdir"/files/plymouth-theme/* "$pkgdir/usr/share/plymouth/themes/nidara/"

    # The initramfs hook, as a drop-in that EDITS the machine's HOOKS rather
    # than declaring them. The reasoning is in the file, and it is the whole
    # difference between this and what archiso does.
    install -Dm644 "$startdir/files/mkinitcpio-nidara.conf" \
        "$pkgdir/etc/mkinitcpio.conf.d/nidara.conf"

    # System defaults (see the inherited-not-ratified warning above).
    install -Dm644 "$startdir/files/nidara-watchdog.conf" \
        "$pkgdir/etc/systemd/system.conf.d/nidara-watchdog.conf"

    # A journal that survives a reboot. Unlike the watchdog above this one IS a
    # decision, and the file argues it: without it, everything that fails before
    # somebody can open a terminal leaves no record once they restart.
    install -Dm644 "$startdir/files/nidara-journal.conf" \
        "$pkgdir/etc/systemd/journald.conf.d/nidara-journal.conf"

    # Rebuild the initramfs when either of the two files that belong in it
    # changes. A hook rather than a scriptlet so that pacman coalesces it: an
    # upgrade touching both files regenerates once.
    install -Dm644 "$startdir/files/nidara-system.hook" \
        "$pkgdir/usr/share/libalpm/hooks/90-nidara-system.hook"

    # fastfetch reads /etc/xdg/fastfetch/ only when ~/.config/fastfetch/ has no
    # config, so a user's own replaces this whole file and never merges with it.
    install -Dm644 "$startdir/files/fastfetch/config.jsonc" \
        "$pkgdir/etc/xdg/fastfetch/config.jsonc"
    install -Dm644 "$startdir/files/fastfetch/nidara.txt" \
        "$pkgdir/usr/share/nidara-system/fastfetch/nidara.txt"
}
