// Nidara's system-wide fastfetch configuration (installed by nidara-system).
//
// fastfetch reads ~/.config/fastfetch/config.jsonc first and /etc/xdg/fastfetch/
// only when that is absent, so a user's own config replaces this one entirely;
// nothing here is ever edited in place.
//
// The logo is the brand "N" as half-block text rather than an image: it renders
// in any terminal, over SSH and on a TTY, where an image protocol would not.
// Colours are ANSI names, so they follow whatever palette the terminal has.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "/usr/share/nidara-system/fastfetch/nidara.txt",
        "color": { "1": "default" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "blue", "title": "blue" }
    },
    "modules": [
        { "type": "title", "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}" },
        { "type": "separator", "string": "─" },
        { "type": "os",       "key": "󰌢", "format": "{pretty-name}" },
        { "type": "kernel",   "key": "" },
        { "type": "uptime",   "key": "󰅐" },
        { "type": "packages", "key": "󰏖" },
        { "type": "wm",       "key": "", "format": "Nidara · {pretty-name}" },
        { "type": "terminal", "key": "" },
        "break",
        { "type": "cpu",      "key": "󰻠", "showPeCoreCount": true },
        { "type": "gpu",      "key": "󰍹" },
        { "type": "memory",   "key": "󰍛" },
        { "type": "disk",     "key": "󰋊", "folders": "/" },
        "break",
        { "type": "colors",   "symbol": "circle" }
    ]
}
