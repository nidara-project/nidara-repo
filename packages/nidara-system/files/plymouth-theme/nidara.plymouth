[Plymouth Theme]
Name=Nidara
Description=Official Nidara boot splash screen
ModuleName=two-step

[two-step]
Font=Inter 11
TitleFont=Inter Medium 14
MonospaceFont=JetBrains Mono 11
ImageDir=/usr/share/plymouth/themes/nidara
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.55
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.55
HorizontalAlignment=.5
VerticalAlignment=.55
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.28
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0xff000000
BackgroundEndColor=0xff000000
ProgressBarBackgroundColor=0xff000000
ProgressBarForegroundColor=0xffffffff
MessageBelowAnimation=true

[boot-up]
UseEndAnimation=false
UseFirmwareBackground=false

[shutdown]
UseEndAnimation=false
UseFirmwareBackground=false

[reboot]
UseEndAnimation=false
UseFirmwareBackground=false
