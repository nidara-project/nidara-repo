# The theme is set with plymouth's own tool rather than by shipping
# /etc/plymouth/plymouthd.conf, because that path is NOT ours: the `plymouth`
# package owns it, and as a backup= file, which is the right thing for it to be.
# Shipping it would be a file conflict; force-overwriting it would take a config
# file away from the admin it belongs to. `plymouth-set-default-theme` writes
# `Theme=` into that file, pacman sees a modified backup file and preserves it
# across plymouth upgrades — which is the behaviour we want and the reason the
# mechanism exists.
_set_theme() {
    if command -v plymouth-set-default-theme >/dev/null 2>&1 \
       && [ -d /usr/share/plymouth/themes/nidara ]; then
        plymouth-set-default-theme nidara >/dev/null 2>&1 || true
    fi
}

# Printing (the `cups` dependency). The SERVICE, not only the socket.
#
# Arch's cups.socket listens on /run/cups/cups.sock and nothing else. Printing
# from an app goes through that socket and works, but the admin page every
# desktop offers — "Manage Printing", cups.desktop, which opens
# http://localhost:631 — is TCP, and nothing listens there until cupsd has been
# started by something else. Measured on a VM with only the socket enabled: 631
# refuses; after one `lpstat -r` it answers 200. So cupsd runs from boot (≈9 MB
# RSS). `enable cups.service` also enables cups.socket and cups.path — the
# unit's own `Also=`.
#
# Enabled ONCE per decision, never on later upgrades — an admin who disables
# printing must stay disabled across every future `pacman -Syu`:
#   - on install, and on the upgrade that brings `cups` to a machine that had
#     this package before it depended on it (from below 5): everything;
#   - on the upgrade from 5, which enabled only the socket: the service, but ONLY
#     if the socket is still enabled. A socket somebody disabled is that
#     decision, and 5 must not be read as consent to more than it did.
#
# `enable` works in the installer's chroot (it only writes symlinks, and
# `is-enabled` only reads them); `start` is attempted only on a booted system,
# where there is a manager to ask.
_enable_printing() {
    systemctl enable cups.service >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl start cups.service >/dev/null 2>&1 || true
    fi
}

post_install() {
    _set_theme
    _enable_printing
    cat <<'MSG'
  Nidara system policy installed.

  The boot splash also needs `splash` on the kernel command line. On a machine
  installed by the Nidara installer that is already there. On any other machine
  it is yours to add — this package will not edit a bootloader it did not write.
MSG
}

post_upgrade() {
    _set_theme
    # $2 is the version being upgraded FROM.
    if [ "$(vercmp "$2" 5)" -lt 0 ]; then
        _enable_printing
    elif [ "$(vercmp "$2" 6)" -lt 0 ] \
         && systemctl is-enabled --quiet cups.socket 2>/dev/null; then
        _enable_printing
    fi
}

pre_remove() {
    # Hand the theme back rather than leaving plymouthd pointing at a directory
    # that is about to stop existing — that is a boot with no splash and an
    # error in the log, instead of a boot with the distribution's own default.
    if command -v plymouth-set-default-theme >/dev/null 2>&1; then
        if [ "$(plymouth-set-default-theme 2>/dev/null)" = "nidara" ]; then
            plymouth-set-default-theme -r >/dev/null 2>&1 || true
        fi
    fi
}
